<Window x:Class="registro_de_usuarios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:registro_de_usuarios"
        mc:Ignorable="d"
        Title="Registro de Usuarios" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <Label Content="Nombre Completo:" />
            <TextBox x:Name="txtNombre" Width="200" />

            <Label Content="Número de Cédula:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtCedula" Width="200" />

            <Label Content="Correo:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtCorreo" Width="200" />

            <Label Content="Contraseña:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtContrasena" Width="200" />

            <Label Content="Placa del Vehiculo:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtPlaca" Width="200" />
            
            <Label Content="telefono" Margin="0,10,0,0"/>
            <TextBox x:Name="txtTelefono" Width="200" />
            
            <Label Content="Fecha de Nacimiento" Margin="0,10,0,0"/>
            <DatePicker x:Name="dpFechaNacimiento" Width="200" />


            <Button Content="Registrar" Width="100" Margin="0,20,0,0" HorizontalAlignment="Center" Click="Button_Click"/>

        </StackPanel>
    </Grid>
</Window>